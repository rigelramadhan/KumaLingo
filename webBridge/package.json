{
  "name": "@kumalingo/firebase-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Firebase web SDK setup for KumaLingo's Kotlin/Wasm adapter",
  "exports": "./src/firebase.mjs",
  "files": [
    "src/*.mjs"
  ],
  "scripts": {
    "test:rules": "node --test test/firestore-rules.test.mjs",
    "test:exports": "node --test test/export.test.mjs",
    "test:browser": "playwright test --config playwright.config.mjs",
    "test:runtime": "node --experimental-test-module-mocks --test test/runtime.test.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "firebase": "13.2.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.65.0"
  }
}
